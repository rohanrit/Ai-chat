# Hugging Face Token (Optional, required for gated models like Llama 3)
HF_TOKEN=your_huggingface_token_here

# Default model directory
MODELS_DIR=models

# Max characters of an attached file injected into the prompt (default 8000)
MAX_PROMPT_CHARS=8000

# File/image OCR runs fully in-app (RapidOCR + PyMuPDF) - no external binary
# or path configuration is required. No online services are used.
